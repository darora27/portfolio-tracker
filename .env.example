# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — server-side only (import script, cron, trade entry).
# Bypasses RLS. Never expose to the browser, never commit.
SUPABASE_SERVICE_ROLE_KEY=

# Finnhub free tier API key (quotes, candles, earnings calendar).
# Server-side only — never expose to the browser.
FINNHUB_API_KEY=

# Shared secret checked against the Authorization header on
# /api/cron/snapshot, so it can't be triggered by a random public request.
# Vercel Cron sends this automatically once set as a project env var.
# Required in production; optional for local testing.
CRON_SECRET=

# Password gating /trades (viewing and adding trades). There's one owner
# and no accounts system, so this is a single shared password, not a
# per-user login. Required for /trades to ever authenticate successfully.
OWNER_PASSWORD=
