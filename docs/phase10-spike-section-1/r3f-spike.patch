@@ -0,0 +1,44 @@
+"use client";
+
+import { useEffect, useState } from "react";
+import dynamic from "next/dynamic";
+import styles from "./spike.module.css";
+
+const R3fScene = dynamic(() => import("./R3fScene"), { ssr: false });
+
+/**
+ * TEMPORARY reproduction for the acceptance-required representative-phone
+ * measurement rerun only (see docs/phase10-spike-section-1/DECISION.md).
+ *
+ * Server-rendered HTML (and any no-JS client) is stuck on `supported ===
+ * null` until this client-side WebGL capability check resolves — there is
+ * no way to reach the correct fallback text without JS executing. This is
+ * the JS-dependent fallback gap CSS 3D never exhibits (its fallback is a
+ * pure CSS media-query re-flow of the same server-rendered DOM).
+ */
+export function R3fSceneLoader({
+  activeIndex,
+  forceFail,
+}: {
+  activeIndex: number;
+  forceFail: boolean;
+}) {
+  const [supported, setSupported] = useState<boolean | null>(forceFail ? false : null);
+
+  useEffect(() => {
+    if (forceFail) return;
+    const canvas = document.createElement("canvas");
+    const gl = canvas.getContext("webgl") || canvas.getContext("experimental-webgl");
+    setSupported(Boolean(gl));
+  }, [forceFail]);
+
+  if (supported === null) {
+    return <div className={styles.canvasStatus}>Checking WebGL support…</div>;
+  }
+
+  if (supported === false) {
+    return null;
+  }
+
+  return <R3fScene activeIndex={activeIndex} />;
+}
