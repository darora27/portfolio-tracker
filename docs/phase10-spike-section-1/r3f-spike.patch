+import { cookies } from "next/headers";
+import type { Metadata } from "next";
+import { isValidSession, SESSION_COOKIE_NAME } from "@/lib/auth";
+import { LoginForm } from "@/components/auth/LoginForm";
+import { OBSERVATORY_CHAPTERS, resolveObservatoryChapter } from "@/lib/observatory/chapters";
+import { R3fSceneLoader } from "./R3fSceneLoader";
+import styles from "./spike.module.css";
+
+export const metadata: Metadata = {
+  title: "Phase 10 §1 spike — R3F (temporary)",
+  robots: { index: false, follow: false },
+};
+
+/**
+ * TEMPORARY, non-committed reproduction of the Phase 10 §1 R3F spike,
+ * recreated only for the acceptance-required representative-phone
+ * performance rerun (see docs/phase10-spike-section-1/DECISION.md,
+ * "Phone-profile measurement recreation (acceptance remediation)"). Not
+ * part of production; removed again, along with three/@react-three/fiber/
+ * @types/three, before the refiner's final commit — see
+ * docs/phase10-spike-section-1/r3f-spike.patch for the retained,
+ * non-executing reproduction copy of this exact source.
+ *
+ * Same isolated-spike contract as the original builder/refiner passes:
+ * owner-gated, synthetic content only (no portfolio data, no network
+ * requests), five spatial objects max, no post-processing/physics/orbit
+ * controls, real `<a href>` chapter navigation duplicated beneath the
+ * decorative canvas so it stays keyboard-, touch-, screen-reader-, and
+ * no-JS-operable. Append ?forceFail=1 to force the WebGL-failure fallback.
+ */
+export default async function R3fSpikePage({
+  searchParams,
+}: {
+  searchParams: Promise<{ chapter?: string; forceFail?: string }>;
+}) {
+  const ownerPassword = process.env.OWNER_PASSWORD;
+  const cookieStore = await cookies();
+  const session = cookieStore.get(SESSION_COOKIE_NAME)?.value;
+  const authenticated = ownerPassword ? isValidSession(session, ownerPassword) : false;
+
+  if (!authenticated) {
+    return (
+      <div className="mx-auto max-w-sm px-4 py-16">
+        <h1 className="mt-3 text-xl font-semibold text-text-primary">Phase 10 §1 spike — R3F</h1>
+        <p className="mt-1 text-sm text-text-secondary">Sign in to view.</p>
+        <LoginForm />
+      </div>
+    );
+  }
+
+  const params = await searchParams;
+  const active = resolveObservatoryChapter(params.chapter);
+  const forceFail = params.forceFail === "1";
+
+  return (
+    <div className={styles.stage} data-force-no-3d={forceFail ? "true" : "false"}>
+      <div className={styles.lead}>
+        <h1 className={styles.leadHeading}>Phase 10 §1 spike — R3F</h1>
+        <p className={styles.leadSub}>
+          Isolated prototype, temporarily recreated only for the
+          representative-phone performance rerun required by Codex
+          Acceptance. Synthetic content only — no portfolio data. Append{" "}
+          <code>?forceFail=1</code> to force the WebGL failure fallback.
+        </p>
+      </div>
+
+      <div className={styles.orbitWrap}>
+        <div className={styles.canvasLayer} aria-hidden="true">
+          <R3fSceneLoader activeIndex={active.index} forceFail={forceFail} />
+        </div>
+        <nav aria-label="Observatory chapters (spike)" className={styles.orbit}>
+          {OBSERVATORY_CHAPTERS.map((chapter) => (
+            <a
+              key={chapter.id}
+              href={`/dev/phase10-spike-r3f?chapter=${chapter.id}${forceFail ? "&forceFail=1" : ""}`}
+              data-index={chapter.index}
+              aria-current={chapter.id === active.id ? "page" : undefined}
+              className={styles.body}
+            >
+              <span aria-hidden="true">{chapter.number}</span>
+              <span className="sr-only">{chapter.label}</span>
+            </a>
+          ))}
+          <div className={styles.inspector} aria-live="off">
+            <p className={styles.inspectorNumber}>{active.number}</p>
+            <p className={styles.inspectorLabel}>{active.label}</p>
+            <p className={styles.inspectorQuestion}>{active.question}</p>
+          </div>
+        </nav>
+      </div>
+
+      <article className={styles.plate} aria-labelledby="spike-plate-heading">
+        <h2 id="spike-plate-heading" className="sr-only">
+          {active.label} plate
+        </h2>
+        <p className={styles.plateFinding}>
+          Synthetic finding for &ldquo;{active.label}&rdquo; — evidence plate placeholder.
+        </p>
+        <div className={styles.plateEvidence} aria-hidden="true" />
+      </article>
+    </div>
+  );
+}
