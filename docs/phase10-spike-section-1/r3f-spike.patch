+"use client";
+
+/**
+ * TEMPORARY reproduction for the acceptance-required representative-phone
+ * measurement rerun only (see docs/phase10-spike-section-1/DECISION.md).
+ * Five static spheres, no post-processing, no physics, no orbit controls —
+ * matches the §1 architecture spike limits in docs/PHASE10_UX_ARCHITECTURE.md §8.
+ */
+
+const POSITIONS: [number, number, number][] = [
+  [-2.1, -0.6, 0.4],
+  [0.6, -1.7, -0.2],
+  [2.2, -0.1, 0.3],
+  [1.2, 1.5, -0.3],
+  [-1.4, 1.3, 0.1],
+];
+
+export function CanvasBodies({ activeIndex }: { activeIndex: number }) {
+  return (
+    <>
+      {POSITIONS.map((position, i) => (
+        <mesh key={i} position={position} scale={i === activeIndex ? 1.15 : 1}>
+          <sphereGeometry args={[0.42, 24, 24]} />
+          <meshStandardMaterial
+            color={i === activeIndex ? "#4fd1c5" : "#3a3a42"}
+            emissive={i === activeIndex ? "#1c6b63" : "#000000"}
+          />
+        </mesh>
+      ))}
+    </>
+  );
+}
