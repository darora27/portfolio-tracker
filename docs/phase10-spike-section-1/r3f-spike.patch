@@ -0,0 +1,32 @@
+"use client";
+
+import { Canvas } from "@react-three/fiber";
+import { CanvasBodies } from "./CanvasBodies";
+
+/**
+ * TEMPORARY reproduction for the acceptance-required representative-phone
+ * measurement rerun only (see docs/phase10-spike-section-1/DECISION.md).
+ *
+ * `style={{ pointerEvents: "none" }}` is required here, not merely on an
+ * ancestor: @react-three/fiber's <Canvas> sets its own wrapper's inline
+ * pointerEvents style ("auto" by default), which silently overrides any
+ * ancestor `pointer-events: none` from CSS regardless of specificity,
+ * because inheritance only applies when no value is set at all. This was
+ * the concrete engineering-reliability risk the original §1 refiner pass
+ * found and documented — reproduced here so it stays fixed in this
+ * temporary spike too.
+ */
+export default function R3fScene({ activeIndex }: { activeIndex: number }) {
+  return (
+    <Canvas
+      style={{ pointerEvents: "none" }}
+      dpr={1}
+      camera={{ position: [0, 0, 6], fov: 45 }}
+      gl={{ antialias: true }}
+    >
+      <ambientLight intensity={0.6} />
+      <pointLight position={[5, 5, 5]} intensity={0.8} />
+      <CanvasBodies activeIndex={activeIndex} />
+    </Canvas>
+  );
+}
